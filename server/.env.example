# ==============================================================================
# TradeVault / Indian Market AI Trading Agent — Environment Configuration
# ==============================================================================

# ---- App Configuration ----
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ---- MongoDB Database ----
MONGODB_URI=mongodb://localhost:27017/confluence

# ---- Authentication & Security ----
# Master session secret (Generate via: openssl rand -hex 32)
JWT_SECRET=
SESSION_COOKIE_NAME=confluence_session

# ---- AES-256-GCM Credential Encryption ----
# 32-byte master encryption key (Generate via: openssl rand -hex 32)
MASTER_ENCRYPTION_KEY=

# ---- Primary LLM Provider: Google Gemini API ----
# Gemini is used for fundamentals analysis, news summaries, and multi-agent debates
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Secondary LLM Provider: Groq Cloud (GPT Models) ----
# Groq is used for second opinions, sentiment auditing, and Risk/Portfolio Management
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# ---- Optional Fallback: OpenRouter ----
# Only used if explicitly set; skipped silently if blank
OPENROUTER_API_KEY=

# ---- Internal Agent Runtime Communication ----
AGENT_RUNTIME_URL=http://localhost:8000
# Shared secret for internal endpoints (Generate via: openssl rand -hex 32)
INTERNAL_SECRET=

# ---- Virtual Paper Trading Mode ----
PAPER_TRADING_ONLY=true

# ---- Observability ----
LOG_LEVEL=info
