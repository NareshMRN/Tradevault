# ---- App Configuration ----
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ---- MongoDB Database ----
MONGODB_URI=mongodb://localhost:27017/confluence

# ---- Redis & BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Authentication & Security ----
JWT_SECRET=confluence-jwt-secret-at-least-64-characters-long-super-secure-key-321
SESSION_COOKIE_NAME=confluence_session

# ---- AES-256-GCM Credential Encryption ----
# 32-byte master encryption key
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- LLM Providers (System Fallback Keys) ----
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
AGENT_ROUTER_API_KEY=

# ---- Brokers ----
# Alpaca
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALLOW_LIVE_TRADING=false

# Groww Trading API (growwapi)
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=
GROWW_TOTP_SECRET=

# ---- Python Agent Runtime Service ----
AGENT_RUNTIME_URL=http://localhost:8000
AGENT_RUNTIME_INTERNAL_SECRET=confluence-shared-internal-secret-token-xyz987

# ---- Notifications (Optional) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=alerts@confluence.local

# ---- Observability ----
LOG_LEVEL=info
SENTRY_DSN=
