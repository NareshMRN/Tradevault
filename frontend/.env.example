# Frontend Environment Variables Template
# In local development, you can leave these blank to use the built-in Vite dev proxy (target: http://localhost:4000).

# Backend API Gateway URL (e.g. https://your-backend-api.onrender.com or https://api.yourdomain.com)
VITE_API_URL=

# WebSocket Server URL (e.g. wss://your-backend-api.onrender.com or https://your-backend-api.onrender.com)
# Defaults to VITE_API_URL if omitted.
VITE_SOCKET_URL=
